@{
    var items = new (string Href, string Icon, string Label, bool ExactMatch)[]
    {
        ("", "🏠", "Start", true),
        ("wochenplan", "📅", "Plan", false),
        ("rezepte", "📖", "Rezepte", false),
        ("menus", "🍽️", "Menüs", false),
        ("kategorien", "🏷️", "Kategorien", false),
    };
}

<div class="bottom-nav">
    <div class="bottom-nav-list">
        @foreach (var item in items)
        {
            <NavLink class="bottom-nav-item" href="@item.Href" Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <span class="nav-icon">@item.Icon</span>
                <span>@item.Label</span>
            </NavLink>
        }
    </div>
</div>
