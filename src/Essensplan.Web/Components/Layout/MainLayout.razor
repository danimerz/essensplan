@inherits LayoutComponentBase
@inject CurrentUserService CurrentUser

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">🍲</div>
            <div class="brand-text">
                <strong>Essensplan</strong>
                <span>Menüs &amp; Wochenplan</span>
            </div>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <ThemeToggle />
            <div class="user-chip">
                <div>
                    @if (_householdName is not null)
                    {
                        <div class="text-sm muted" style="margin-bottom:0.1rem;">🏠 @_householdName</div>
                    }
                    <a href="/konto" class="muted text-sm" style="text-decoration:none;">@_email</a>
                </div>
                <a class="btn btn-ghost btn-sm" href="/abmelden">Abmelden</a>
            </div>
        </div>
    </aside>

    <div>
        <header class="topbar">
            <div class="brand">
                <div class="brand-mark">🍲</div>
                <strong>Essensplan</strong>
            </div>
            <div class="row" style="gap:0.5rem;">
                <ThemeToggle />
                <a class="btn btn-ghost btn-sm" href="/abmelden">↩</a>
            </div>
        </header>

        <main class="app-main">
            @Body
        </main>
    </div>

    <BottomNav />
</div>

<div id="blazor-error-ui">
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="" class="reload">Neu laden</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string? _email;
    private string? _householdName;

    protected override async Task OnInitializedAsync()
    {
        _email = await CurrentUser.GetEmailAsync();
        _householdName = await CurrentUser.GetHouseholdNameAsync();
    }
}
