@page "/kategorien"
@attribute [Authorize]
@inject CategoryService CategoryService

<PageTitle>Kategorien – Essensplan</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Rezeptbuch</span>
        <h1>Kategorien</h1>
        <p class="lead">Ordne deine Rezepte in Kategorien wie Hauptgericht, Dessert oder Suppe.</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" @onclick="OpenCreate">+ Neue Kategorie</button>
    </div>
</div>

@if (_error is not null && _editing is null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_categories is null)
{
    <span class="spinner"></span>
}
else if (_categories.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">🏷️</div>
        <h3>Keine Kategorien</h3>
        <p>Leg deine erste Kategorie an.</p>
    </div>
}
else
{
    <div class="grid-cards">
        @foreach (var cat in _categories)
        {
            <div class="card card-pad" style="border-top: 3px solid @cat.Color;">
                <div class="row-between">
                    <div class="row">
                        <span style="font-size:1.5rem;">@cat.Icon</span>
                        <strong>@cat.Name</strong>
                    </div>
                    <div class="row" style="gap:0.25rem;">
                        <button class="btn btn-ghost btn-icon btn-sm" title="Bearbeiten" @onclick="() => OpenEdit(cat)">✏️</button>
                        <button class="btn btn-ghost btn-icon btn-sm" title="Löschen" @onclick="() => Delete(cat)">🗑️</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="CloseEditor">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="mb-0">@(_editing.Id == 0 ? "Neue Kategorie" : "Kategorie bearbeiten")</h3>
            </div>

            <div class="field">
                <label>Name</label>
                <input class="input" @bind="_editing.Name" @bind:event="oninput" placeholder="z. B. Hauptgericht" />
            </div>

            <div class="field">
                <label>Icon (Emoji)</label>
                <input class="input" style="max-width:100px;" @bind="_editing.Icon" @bind:event="oninput" />
            </div>

            <div class="field mb-0">
                <label>Farbe</label>
                <div class="color-swatches">
                    @foreach (var color in _palette)
                    {
                        <div class="color-swatch @(_editing.Color == color ? "selected" : "")"
                             style="background:@color;"
                             @onclick="() => _editing.Color = color"></div>
                    }
                </div>
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger" style="margin-top:1rem;">@_error</div>
            }

            <div class="row" style="justify-content:flex-end; margin-top:1.25rem;">
                <button class="btn btn-ghost" @onclick="CloseEditor">Abbrechen</button>
                <button class="btn btn-primary" @onclick="Save">Speichern</button>
            </div>
        </div>
    </div>
}

@code {
    private List<RecipeCategory>? _categories;
    private RecipeCategory? _editing;
    private string? _error;

    private readonly string[] _palette =
    {
        "#FF6B4A", "#2F6F5E", "#FFB648", "#4ECDC4", "#C77DFF",
        "#F4A261", "#06D6A0", "#E5484D", "#5C7CFA", "#845EF7"
    };

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        _categories = await CategoryService.GetAllAsync();
    }

    private void OpenCreate()
    {
        _error = null;
        _editing = new RecipeCategory { Color = _palette[0], Icon = "🍽️", SortOrder = (_categories?.Count ?? 0) + 1 };
    }

    private void OpenEdit(RecipeCategory cat)
    {
        _error = null;
        _editing = new RecipeCategory { Id = cat.Id, Name = cat.Name, Icon = cat.Icon, Color = cat.Color, SortOrder = cat.SortOrder };
    }

    private void CloseEditor() => _editing = null;

    private async Task Save()
    {
        if (_editing is null) return;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _error = "Bitte einen Namen angeben.";
            return;
        }

        if (_editing.Id == 0)
        {
            await CategoryService.CreateAsync(_editing);
        }
        else
        {
            await CategoryService.UpdateAsync(_editing);
        }

        _editing = null;
        await Load();
    }

    private async Task Delete(RecipeCategory cat)
    {
        var ok = await CategoryService.DeleteAsync(cat.Id);
        if (!ok)
        {
            _error = $"„{cat.Name}“ wird noch von Rezepten verwendet und kann nicht gelöscht werden.";
            return;
        }
        await Load();
    }
}
