@page "/rezepte/{Id:int}"
@attribute [Authorize]
@using System.Text.RegularExpressions
@inject RecipeService RecipeService
@inject RecipeRatingService RatingService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>@(_recipe?.Name ?? "Rezept") – Essensplan</PageTitle>

@if (_recipe is null)
{
    <span class="spinner"></span>
}
else
{
    <div class="row-between" style="margin-bottom:1rem;">
        <a href="/rezepte" class="btn btn-ghost btn-sm">← Zurück</a>
        <div class="row">
            <a href="@($"/rezepte/{_recipe.Id}/bearbeiten")" class="btn btn-secondary btn-sm">✏️ Bearbeiten</a>
            <button class="btn btn-danger btn-sm" @onclick="() => _confirmDelete = true">🗑️ Löschen</button>
        </div>
    </div>

    <div class="card" style="overflow:hidden; margin-bottom:1.5rem;">
        <div class="recipe-card-media" style="aspect-ratio: 21/9;">
            @if (!string.IsNullOrWhiteSpace(_recipe.ImageUrl))
            {
                <img src="@_recipe.ImageUrl" alt="@_recipe.Name" />
            }
            else
            {
                <div class="placeholder">@(_recipe.Category?.Icon ?? "🍽️")</div>
            }
        </div>
        <div class="card-pad">
            @if (_recipe.Category is not null)
            {
                <span class="chip" style="background:color-mix(in srgb, @_recipe.Category.Color 16%, transparent); color:@_recipe.Category.Color; margin-bottom:0.6rem;">
                    <span class="chip-dot"></span>@_recipe.Category.Name
                </span>
            }
            <h1>@_recipe.Name</h1>
            @if (!string.IsNullOrWhiteSpace(_recipe.Description))
            {
                <p class="lead">@_recipe.Description</p>
            }

            <div class="row" style="gap:1.5rem; margin-top:1rem;">
                <div class="stat-tile" style="padding:0.7rem 1rem;">
                    <span class="stat-value" style="font-size:1.1rem;">@_recipe.PrepTimeMinutes min</span>
                    <span class="stat-label">Vorbereitung</span>
                </div>
                <div class="stat-tile" style="padding:0.7rem 1rem;">
                    <span class="stat-value" style="font-size:1.1rem;">@_recipe.CookTimeMinutes min</span>
                    <span class="stat-label">Kochzeit</span>
                </div>
                <div class="stat-tile" style="padding:0.7rem 1rem;">
                    <span class="stat-value" style="font-size:1.1rem;">@_recipe.Servings</span>
                    <span class="stat-label">Portionen</span>
                </div>
                @if (_ratingCount > 0)
                {
                    <div class="stat-tile" style="padding:0.7rem 1rem;">
                        <span class="stat-value" style="font-size:1.1rem;">@_ratingAverage.ToString("0.0") ⭐</span>
                        <span class="stat-label">@_ratingCount Bewertung@(_ratingCount == 1 ? "" : "en")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_recipe.SourceUrl))
            {
                <p class="text-sm muted" style="margin-top:1rem;">
                    Quelle: <a href="@_recipe.SourceUrl" target="_blank" rel="noopener noreferrer">@_recipe.SourceUrl</a>
                </p>
            }
        </div>
    </div>

    <div class="form-grid" style="gap:1.5rem; margin-bottom:1.5rem;">
        <div class="card card-pad">
            <h2>Zutaten</h2>
            @if (_recipe.Ingredients.Count == 0)
            {
                <p class="muted">Keine Zutaten erfasst.</p>
            }
            else
            {
                <ul class="stack" style="gap:0.5rem;">
                    @foreach (var ing in _recipe.Ingredients.OrderBy(i => i.SortOrder))
                    {
                        <li class="row" style="gap:0.5rem; border-bottom:1px solid var(--border); padding-bottom:0.5rem;">
                            <strong style="min-width:70px;">@(ing.Quantity?.ToString("0.##")) @ing.Unit</strong>
                            <span>@ing.Name</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card card-pad">
            <h2>Zubereitung</h2>
            @if (string.IsNullOrWhiteSpace(_recipe.Instructions))
            {
                <p class="muted">Keine Anleitung erfasst.</p>
            }
            else
            {
                <div style="white-space: pre-line; line-height: 1.75;">
                    @foreach (var seg in ParseInstructions(_recipe.Instructions))
                    {
                        @if (seg.IsTimer)
                        {
                            <button type="button" class="timer-chip"
                                    @onclick="() => _timer!.SetTimer(seg.Seconds, seg.Text)">
                                ⏱ @seg.Text
                            </button>
                        }
                        else
                        {
                            @seg.Text
                        }
                    }
                </div>
            }
        </div>
    </div>

    <!-- Bewertungen -->
    <div class="card card-pad">
        <h2>Bewertungen</h2>

        @if (_userId is not null)
        {
            <div style="margin-bottom:1.5rem; padding-bottom:1.25rem; border-bottom:1px solid var(--border);">
                <p class="text-sm muted" style="margin-bottom:0.5rem;">Deine Bewertung:</p>
                <div class="star-rating" style="margin-bottom:0.75rem;">
                    @for (var s = 1; s <= 5; s++)
                    {
                        var star = s;
                        <button type="button" class="star-btn @(_myStars >= star ? "filled" : "empty")"
                                @onclick="() => _myStars = star">★</button>
                    }
                </div>
                <textarea class="input textarea" style="margin-bottom:0.75rem; min-height:4rem;"
                          placeholder="Kommentar (optional)…"
                          @bind="_myComment"></textarea>
                <LoadingButton CssClass="btn btn-primary btn-sm" OnClick="SaveRating">Bewertung speichern</LoadingButton>
            </div>
        }

        @if (_ratings.Count == 0)
        {
            <p class="muted text-sm">Noch keine Bewertungen.</p>
        }
        else
        {
            <div class="stack" style="gap:0.85rem;">
                @foreach (var r in _ratings)
                {
                    <div>
                        <div class="row-between">
                            <span class="text-sm" style="font-weight:700;">@(r.User?.DisplayName ?? r.User?.Email ?? "Unbekannt")</span>
                            <span class="text-sm muted">@r.CreatedAt.ToLocalTime().ToString("d. MMM yyyy")</span>
                        </div>
                        <div class="star-rating" style="gap:0.1rem;">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <span class="star-btn @(r.Stars >= s ? "filled" : "empty")" style="cursor:default; font-size:1rem;">★</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <p class="text-sm" style="margin:0.35rem 0 0;">@r.Comment</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<ConfirmDialog IsOpen="_confirmDelete"
               Title="Rezept löschen?"
               Message="@_deleteMessage"
               OnCancel="() => _confirmDelete = false"
               OnConfirm="DeleteRecipe" />

<RecipeTimer @ref="_timer" />

@code {
    [Parameter] public int Id { get; set; }
    private Recipe? _recipe;
    private bool _confirmDelete;
    private int _householdId;
    private string _deleteMessage => string.Concat(_recipe?.Name, " wird endgültig gelöscht.");
    private string? _userId;
    private RecipeTimer? _timer;

    private record InstructionSegment(string Text, bool IsTimer, int Seconds = 0);

    private static readonly Regex TimerRegex = new(
        @"\b(\d+)\s*(Stunden?|Minuten?|Min\.?|Sekunden?|Sek\.?|h\b)",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);

    private static List<InstructionSegment> ParseInstructions(string text)
    {
        var segments = new List<InstructionSegment>();
        int lastIndex = 0;
        foreach (Match m in TimerRegex.Matches(text))
        {
            if (m.Index > lastIndex)
                segments.Add(new InstructionSegment(text[lastIndex..m.Index], false));

            var value = int.Parse(m.Groups[1].Value);
            var unit = m.Groups[2].Value.ToLower();
            var seconds = unit.StartsWith("h") || unit.StartsWith("stund")
                ? value * 3600
                : unit.StartsWith("sek")
                    ? value
                    : value * 60;

            segments.Add(new InstructionSegment(m.Value, true, seconds));
            lastIndex = m.Index + m.Length;
        }
        if (lastIndex < text.Length)
            segments.Add(new InstructionSegment(text[lastIndex..], false));
        return segments;
    }

    private List<RecipeRating> _ratings = new();
    private double _ratingAverage;
    private int _ratingCount;
    private int _myStars = 5;
    private string? _myComment;

    protected override async Task OnParametersSetAsync()
    {
        _householdId = await CurrentUser.GetHouseholdIdAsync() ?? 0;
        _userId = await CurrentUser.GetUserIdAsync();
        _recipe = await RecipeService.GetByIdAsync(Id, _householdId);
        await LoadRatings();
    }

    private async Task LoadRatings()
    {
        _ratings = await RatingService.GetForRecipeAsync(Id, _householdId);
        (_ratingAverage, _ratingCount) = await RatingService.GetStatsAsync(Id, _householdId);

        if (_userId is not null)
        {
            var my = await RatingService.GetMyRatingAsync(Id, _userId, _householdId);
            if (my is not null)
            {
                _myStars = my.Stars;
                _myComment = my.Comment;
            }
        }
    }

    private async Task SaveRating()
    {
        if (_userId is null) return;
        await RatingService.UpsertAsync(Id, _userId, _householdId, _myStars, _myComment);
        await LoadRatings();
    }

    private async Task DeleteRecipe()
    {
        await RecipeService.DeleteAsync(Id, _householdId);
        Nav.NavigateTo("/rezepte");
    }
}
