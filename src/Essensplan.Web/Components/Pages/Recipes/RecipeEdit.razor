@page "/rezepte/neu"
@attribute [Authorize]
@page "/rezepte/{Id:int}/bearbeiten"
@attribute [Authorize]
@inject RecipeService RecipeService
@inject CategoryService CategoryService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>@(IsEditMode ? "Rezept bearbeiten" : "Neues Rezept") – Essensplan</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Rezeptbuch</span>
        <h1>@(IsEditMode ? "Rezept bearbeiten" : "Neues Rezept")</h1>
    </div>
</div>

<div class="container-narrow">

    @* Shared-recipe notice in edit mode *@
    @if (IsEditMode && _shareCount > 1)
    {
        <div class="alert" style="background:color-mix(in srgb, var(--accent) 10%, transparent); border:1px solid var(--accent); margin-bottom:1.25rem;">
            ℹ️ Dieses Rezept wird von <strong>@(_shareCount - 1) weiteren Haushalt@(_shareCount == 2 ? "" : "en")</strong> verwendet.
            Beim Speichern wird automatisch eine Kopie für deinen Haushalt erstellt.
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card card-pad" style="margin-bottom:1.25rem;">
            <div class="field">
                <label>Name</label>
                <InputText class="input" @bind-Value="_model.Name" @onblur="CheckNameDuplicate"
                           placeholder="z. B. Spaghetti Bolognese" />
                @if (_nameMatches is not null && _nameMatches.Count > 0)
                {
                    <div style="margin-top:0.75rem;">
                        <div style="font-weight:600; margin-bottom:0.5rem;">
                            @(_nameMatches.Count == 1
                                ? "Dieses Rezept existiert bereits in der Bibliothek:"
                                : $"Dieses Rezept existiert in {_nameMatches.Count} Versionen – wähle die passende:")
                        </div>
                        <div class="stack" style="gap:0.5rem; margin-bottom:0.5rem;">
                            @foreach (var m in _nameMatches)
                            {
                                <div class="card" style="display:flex; flex-direction:row; gap:0.75rem; align-items:center; padding:0.75rem; border:1.5px solid var(--border);">
                                    @if (!string.IsNullOrWhiteSpace(m.Recipe.ImageUrl))
                                    {
                                        <img src="@m.Recipe.ImageUrl" alt="" style="width:56px; height:56px; object-fit:cover; border-radius:var(--radius); flex-shrink:0;" />
                                    }
                                    else
                                    {
                                        <div style="width:56px; height:56px; border-radius:var(--radius); background:var(--surface-2); display:flex; align-items:center; justify-content:center; font-size:1.5rem; flex-shrink:0;">
                                            @(m.Recipe.Category?.Icon ?? "🍽️")
                                        </div>
                                    }
                                    <div style="flex:1; min-width:0;">
                                        <div style="font-weight:700;">@m.Recipe.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(m.Recipe.Description))
                                        {
                                            <div class="text-sm muted" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@m.Recipe.Description</div>
                                        }
                                        <div class="row text-sm muted" style="gap:0.75rem; margin-top:0.25rem; flex-wrap:wrap;">
                                            @if (m.Recipe.TotalTimeMinutes > 0)
                                            {
                                                <span>⏱ @m.Recipe.TotalTimeMinutes min</span>
                                            }
                                            @if (m.Recipe.Servings > 0)
                                            {
                                                <span>👥 @m.Recipe.Servings Portionen</span>
                                            }
                                            @if (m.IngredientCount > 0)
                                            {
                                                <span>📋 @m.IngredientCount Zutaten</span>
                                            }
                                            <span style="color:var(--accent);">🏠 @m.HouseholdCount @(m.HouseholdCount == 1 ? "Haushalt" : "Haushalte")</span>
                                        </div>
                                    </div>
                                    <LoadingButton CssClass="btn btn-primary btn-sm" Style="flex-shrink:0;"
                                               OnClick="() => AssignExisting(m.Recipe.Id)">Übernehmen</LoadingButton>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="DismissDuplicate">Keines passt — neu anlegen</button>
                    </div>
                }
                @if (_checkingName)
                {
                    <span class="spinner" style="margin-top:0.4rem;"></span>
                }
            </div>

            <div class="field">
                <label>Kurzbeschreibung</label>
                <InputTextArea class="textarea" style="min-height:3.5rem;" @bind-Value="_model.Description" placeholder="Ein Satz zum Gericht…" />
            </div>

            <div class="form-grid">
                <div class="field">
                    <label>Kategorie</label>
                    <InputSelect class="input" @bind-Value="_model.CategoryId">
                        <option value="">– keine –</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat.Id">@cat.Icon @cat.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label>Bild-URL</label>
                    <InputText class="input" @bind-Value="_model.ImageUrl" placeholder="https://…" />
                </div>
            </div>

            <div class="input-row">
                <div class="field">
                    <label>Vorbereitung (min)</label>
                    <InputNumber class="input" @bind-Value="_model.PrepTimeMinutes" />
                </div>
                <div class="field">
                    <label>Kochzeit (min)</label>
                    <InputNumber class="input" @bind-Value="_model.CookTimeMinutes" />
                </div>
                <div class="field">
                    <label>Portionen</label>
                    <InputNumber class="input" @bind-Value="_model.Servings" />
                </div>
            </div>
        </div>

        <div class="card card-pad" style="margin-bottom:1.25rem;">
            <div class="row-between">
                <h3 class="mb-0">Zutaten</h3>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="AddIngredient">+ Zutat</button>
            </div>
            <div style="margin-top:1rem;">
                @for (var i = 0; i < _ingredients.Count; i++)
                {
                    var index = i;
                    <div class="ingredient-row">
                        <input class="input" placeholder="Menge" value="@_ingredients[index].Quantity" @oninput="e => _ingredients[index].Quantity = e.Value?.ToString() ?? string.Empty" />
                        <input class="input" placeholder="Einheit" value="@_ingredients[index].Unit" @oninput="e => _ingredients[index].Unit = e.Value?.ToString() ?? string.Empty" />
                        <input class="input" placeholder="Zutat" value="@_ingredients[index].Name" @oninput="e => _ingredients[index].Name = e.Value?.ToString() ?? string.Empty" />
                        <button type="button" class="btn btn-ghost btn-icon btn-sm" title="Entfernen" @onclick="() => _ingredients.RemoveAt(index)">✕</button>
                    </div>
                }
                @if (_ingredients.Count == 0)
                {
                    <p class="muted text-sm">Noch keine Zutaten – füge welche hinzu.</p>
                }
            </div>
        </div>

        <div class="card card-pad" style="margin-bottom:1.25rem;">
            <div class="field mb-0">
                <label>Zubereitung</label>
                <InputTextArea class="textarea" style="min-height:10rem;" @bind-Value="_model.Instructions" placeholder="Schritt für Schritt…" />
            </div>
        </div>

        <div class="row" style="justify-content:flex-end;">
            <a class="btn btn-ghost" href="@CancelHref">Abbrechen</a>
            <LoadingButton Type="submit" IsLoading="@_saving">@(IsEditMode ? "Speichern" : "Rezept anlegen")</LoadingButton>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private bool IsEditMode => Id.HasValue;
    private string CancelHref => IsEditMode ? $"/rezepte/{Id}" : "/rezepte";

    private RecipeFormModel _model = new();
    private List<IngredientRow> _ingredients = new();
    private List<RecipeCategory> _categories = new();
    private int _householdId;
    private int _shareCount;
    private List<GlobalRecipeMatch>? _nameMatches;
    private bool _forceSave;
    private bool _checkingName;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _householdId = await CurrentUser.GetHouseholdIdAsync() ?? 0;
        _categories = await CategoryService.GetAllAsync();

        if (IsEditMode)
        {
            var recipe = await RecipeService.GetByIdAsync(Id!.Value, _householdId);
            if (recipe is null)
            {
                Nav.NavigateTo("/rezepte");
                return;
            }

            _shareCount = await RecipeService.GetShareCountAsync(Id.Value);

            _model = new RecipeFormModel
            {
                Name = recipe.Name,
                Description = recipe.Description,
                Instructions = recipe.Instructions,
                PrepTimeMinutes = recipe.PrepTimeMinutes,
                CookTimeMinutes = recipe.CookTimeMinutes,
                Servings = recipe.Servings,
                ImageUrl = recipe.ImageUrl,
                CategoryId = recipe.CategoryId?.ToString() ?? ""
            };

            _ingredients = recipe.Ingredients
                .OrderBy(i => i.SortOrder)
                .Select(i => new IngredientRow
                {
                    Quantity = i.Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "",
                    Unit = i.Unit ?? "",
                    Name = i.Name
                })
                .ToList();
        }

        if (_ingredients.Count == 0)
            AddIngredient();
    }

    private void AddIngredient() => _ingredients.Add(new IngredientRow());

    private async Task CheckNameDuplicate()
    {
        if (IsEditMode || _forceSave || string.IsNullOrWhiteSpace(_model.Name)) return;
        _checkingName = true;
        _nameMatches = null;
        var matches = await RecipeService.FindGlobalMatchesByNameAsync(_model.Name.Trim());
        _nameMatches = matches.Count > 0 ? matches : null;
        _checkingName = false;
    }

    private void DismissDuplicate()
    {
        _nameMatches = null;
        _forceSave = true;
    }

    private async Task Save()
    {
        // Fallback check in case user submits without leaving the name field
        if (!IsEditMode && !_forceSave && _nameMatches is null)
        {
            await CheckNameDuplicate();
            if (_nameMatches is not null) return;
        }

        _nameMatches = null;
        _saving = true;

        var recipe = new Recipe
        {
            Id = Id ?? 0,
            Name = _model.Name.Trim(),
            Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description.Trim(),
            Instructions = string.IsNullOrWhiteSpace(_model.Instructions) ? null : _model.Instructions.Trim(),
            PrepTimeMinutes = _model.PrepTimeMinutes,
            CookTimeMinutes = _model.CookTimeMinutes,
            Servings = _model.Servings <= 0 ? 1 : _model.Servings,
            ImageUrl = string.IsNullOrWhiteSpace(_model.ImageUrl) ? null : _model.ImageUrl.Trim(),
            CategoryId = int.TryParse(_model.CategoryId, out var cid) ? cid : null,
            Ingredients = _ingredients
                .Where(i => !string.IsNullOrWhiteSpace(i.Name))
                .Select(i => new RecipeIngredient
                {
                    Name = i.Name.Trim(),
                    Unit = string.IsNullOrWhiteSpace(i.Unit) ? null : i.Unit.Trim(),
                    Quantity = decimal.TryParse(i.Quantity.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var q) ? q : null
                })
                .ToList()
        };

        if (IsEditMode)
        {
            var savedId = await RecipeService.UpdateAsync(recipe, _householdId);
            Nav.NavigateTo($"/rezepte/{savedId}");
        }
        else
        {
            var created = await RecipeService.CreateAsync(recipe, _householdId);
            Nav.NavigateTo($"/rezepte/{created.Id}");
        }
    }

    private async Task AssignExisting(int recipeId)
    {
        await RecipeService.AssignToHouseholdAsync(recipeId, _householdId);
        Nav.NavigateTo($"/rezepte/{recipeId}");
    }

    private class RecipeFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Bitte einen Namen angeben.")]
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? Instructions { get; set; }
        public int PrepTimeMinutes { get; set; }
        public int CookTimeMinutes { get; set; }
        public int Servings { get; set; } = 4;
        public string? ImageUrl { get; set; }
        public string CategoryId { get; set; } = "";
    }

    private class IngredientRow
    {
        public string Quantity { get; set; } = "";
        public string Unit { get; set; } = "";
        public string Name { get; set; } = "";
    }
}
