@page "/rezepte/import"
@attribute [Authorize]
@inject RecipeImportService ImportService
@inject RecipeService RecipeService
@inject CategoryService CategoryService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<PageTitle>Rezept importieren – Essensplan</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Rezeptbuch</span>
        <h1>Rezept importieren</h1>
        <p class="lead">Füge den Link zu einem Rezept ein – die meisten Kochseiten hinterlegen strukturierte Daten, die automatisch ausgelesen werden.</p>
    </div>
</div>

<div class="container-narrow">
    <div class="card card-pad" style="margin-bottom:1.25rem;">
        <div class="field mb-0">
            <label>Rezept-URL</label>
            <div class="row">
                <input class="input" style="flex:1;" placeholder="https://www.beispiel-rezepte.de/spaghetti-bolognese" @bind="_url" @bind:event="oninput" />
                <LoadingButton IsLoading="@_loading" OnClick="Import">Importieren</LoadingButton>
            </div>
            <span class="hint">Funktioniert mit Seiten, die schema.org/Recipe-Daten (JSON-LD) einbetten – das trifft auf die meisten Rezept-Websites zu.</span>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">⚠️ @_error</div>
    }

    @* Duplicate found — ask user what to do *@
    @if (_duplicate is not null && _imported is not null)
    {
        <div class="card card-pad" style="margin-bottom:1.25rem; border:2px solid var(--warning, #f59e0b);">
            <h3 style="margin-bottom:0.5rem;">Rezept bereits vorhanden</h3>
            <p class="muted text-sm" style="margin-bottom:1rem;">
                <strong>@_duplicate.Name</strong> existiert bereits in der globalen Rezeptbibliothek.
                Möchtest du es deinem Haushalt hinzufügen oder trotzdem ein neues Rezept anlegen?
            </p>
            <div class="row" style="gap:0.5rem; flex-wrap:wrap;">
                <LoadingButton OnClick="AssignExisting">Bestehendes übernehmen</LoadingButton>
                <button class="btn btn-ghost" @onclick="() => _duplicate = null">Neu importieren</button>
            </div>
        </div>
    }

    @if (_imported is not null && _duplicate is null)
    {
        <div class="alert alert-success">✅ Rezept gefunden – bitte prüfen und ggf. anpassen, bevor du speicherst.</div>

        <EditForm Model="_imported" OnValidSubmit="SaveImported">
            <div class="card card-pad" style="margin-bottom:1.25rem;">
                <div class="field">
                    <label>Name</label>
                    <InputText class="input" @bind-Value="_imported.Name" />
                </div>
                <div class="field">
                    <label>Kurzbeschreibung</label>
                    <InputTextArea class="textarea" style="min-height:3.5rem;" @bind-Value="_imported.Description" />
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label>Kategorie</label>
                        <InputSelect class="input" @bind-Value="_categoryId">
                            <option value="">– keine –</option>
                            @foreach (var cat in _categories)
                            {
                                <option value="@cat.Id">@cat.Icon @cat.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="field">
                        <label>Bild-URL</label>
                        <InputText class="input" @bind-Value="_imported.ImageUrl" />
                    </div>
                </div>
                <div class="input-row">
                    <div class="field">
                        <label>Vorbereitung (min)</label>
                        <InputNumber class="input" @bind-Value="_imported.PrepTimeMinutes" />
                    </div>
                    <div class="field">
                        <label>Kochzeit (min)</label>
                        <InputNumber class="input" @bind-Value="_imported.CookTimeMinutes" />
                    </div>
                    <div class="field">
                        <label>Portionen</label>
                        <InputNumber class="input" @bind-Value="_imported.Servings" />
                    </div>
                </div>
            </div>

            <div class="card card-pad" style="margin-bottom:1.25rem;">
                <h3>Zutaten (@_imported.Ingredients.Count)</h3>
                @if (_imported.Ingredients.Count == 0)
                {
                    <p class="muted">Keine Zutaten gefunden – bitte manuell ergänzen.</p>
                }
                else
                {
                    <ul class="stack" style="gap:0.35rem;">
                        @foreach (var ing in _imported.Ingredients)
                        {
                            <li class="text-sm">@(ing.Quantity?.ToString("0.##")) @ing.Unit @ing.Name</li>
                        }
                    </ul>
                }
            </div>

            <div class="card card-pad" style="margin-bottom:1.25rem;">
                <div class="field mb-0">
                    <label>Zubereitung</label>
                    <InputTextArea class="textarea" style="min-height:10rem;" @bind-Value="_imported.Instructions" />
                </div>
            </div>

            <div class="row" style="justify-content:flex-end;">
                <button type="button" class="btn btn-ghost" @onclick="Reset">Verwerfen</button>
                <LoadingButton Type="submit" IsLoading="@_saving">Rezept speichern</LoadingButton>
            </div>
        </EditForm>
    }
</div>

@code {
    private string _url = "";
    private bool _loading;
    private bool _saving;
    private string? _error;
    private Recipe? _imported;
    private Recipe? _duplicate;
    private string _categoryId = "";
    private List<RecipeCategory> _categories = new();
    private int _householdId;

    protected override async Task OnInitializedAsync()
    {
        _householdId = await CurrentUser.GetHouseholdIdAsync() ?? 0;
        _categories = await CategoryService.GetAllAsync();
    }

    private async Task Import()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;

        _loading = true;
        _error = null;
        _imported = null;
        _duplicate = null;

        var result = await ImportService.ImportFromUrlAsync(_url.Trim());

        _loading = false;

        if (!result.Success)
        {
            _error = result.ErrorMessage;
            return;
        }

        _imported = result.Recipe;

        // Check for duplicate by source URL
        if (!string.IsNullOrWhiteSpace(_url))
        {
            var existing = await RecipeService.FindGlobalByUrlAsync(_url.Trim());
            if (existing is not null)
                _duplicate = existing;
        }
    }

    private async Task AssignExisting()
    {
        if (_duplicate is null) return;
        await RecipeService.AssignToHouseholdAsync(_duplicate.Id, _householdId);
        Nav.NavigateTo($"/rezepte/{_duplicate.Id}");
    }

    private async Task SaveImported()
    {
        if (_imported is null) return;
        _saving = true;

        _imported.CategoryId = int.TryParse(_categoryId, out var cid) ? cid : null;
        var created = await RecipeService.CreateAsync(_imported, _householdId);
        Nav.NavigateTo($"/rezepte/{created.Id}");
    }

    private void Reset()
    {
        _imported = null;
        _duplicate = null;
        _url = "";
        _error = null;
    }
}
