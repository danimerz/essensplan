@page "/menus"
@inject MenuService MenuService
@inject CurrentUserService CurrentUser

<PageTitle>Menüs – Essensplan</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Planung</span>
        <h1>Menüs</h1>
        <p class="lead">Ein Menü kombiniert ein oder mehrere Rezepte zu einer planbaren Mahlzeit.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/menus/neu">+ Neues Menü</a>
    </div>
</div>

<div class="row" style="margin-bottom:1.25rem;">
    <button class="chip chip-btn @(_filter is null ? "active" : "")" @onclick="() => Filter(null)">Alle</button>
    @foreach (var mt in _mealTypes)
    {
        <button class="chip chip-btn @(_filter == mt ? "active" : "")" @onclick="() => Filter(mt)">@mt.ToIcon() @mt.ToGermanLabel()</button>
    }
</div>

@if (_menus is null)
{
    <span class="spinner"></span>
}
else if (_menus.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">🍽️</div>
        <h3>Keine Menüs</h3>
        <p>Stelle aus deinen Rezepten dein erstes Menü zusammen.</p>
        <a class="btn btn-primary" href="/menus/neu" style="margin-top:1rem; display:inline-flex;">Neues Menü</a>
    </div>
}
else
{
    <div class="grid-cards">
        @foreach (var menu in _menus)
        {
            <a class="card card-pad card-interactive" href="@($"/menus/{menu.Id}/bearbeiten")">
                <div class="row-between" style="margin-bottom:0.5rem;">
                    <span class="badge-mealtype">@MealTypeFlags.ToLabels(menu.AllowedMealTypes)</span>
                </div>
                <div class="recipe-card-title" style="margin-bottom:0.35rem;">@menu.Name</div>
                @if (!string.IsNullOrWhiteSpace(menu.Description))
                {
                    <p class="text-sm muted" style="margin-bottom:0.5rem;">@menu.Description</p>
                }
                <div class="row" style="gap:0.35rem;">
                    @foreach (var mr in menu.MenuRecipes.OrderBy(r => r.SortOrder))
                    {
                        <span class="chip chip-outline">@mr.Recipe?.Name</span>
                    }
                </div>
            </a>
        }
    </div>
}

<a href="/menus/neu" class="fab fab-mobile" title="Neues Menü">+</a>

@code {
    private List<Menu>? _menus;
    private MealType? _filter;
    private int _householdId;
    private readonly MealType[] _mealTypes = Enum.GetValues<MealType>();

    protected override async Task OnInitializedAsync()
    {
        _householdId = await CurrentUser.GetHouseholdIdAsync() ?? 0;
        await Load();
    }

    private async Task Load() => _menus = await MenuService.GetAllAsync(_householdId, _filter);

    private async Task Filter(MealType? mt)
    {
        _filter = mt;
        await Load();
    }
}
