@page "/wochenplan"
@attribute [Authorize]
@page "/wochenplan/{WeekOffset:int}"
@attribute [Authorize]
@implements IDisposable
@inject WeekPlanService WeekPlanService
@inject MenuService MenuService
@inject WeekPlanChangeNotifier ChangeNotifier
@inject CurrentUserService CurrentUser

<PageTitle>Wochenplan – Essensplan</PageTitle>

<div class="page-header">
    <div>
        <span class="eyebrow">Planung</span>
        <h1>Wochenplan</h1>
        <p class="lead">@FormatWeekRange()</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" @onclick="ClearWeek" disabled="@(_week is null)">Woche leeren</button>
        <button class="btn btn-primary" @onclick="AutoGenerate" disabled="@(_generating || _week is null)">
            @if (_generating)
            {
                <span class="spinner"></span>
            }
            else
            {
                <span>✨ Automatisch planen</span>
            }
        </button>
    </div>
</div>

<div class="week-toolbar">
    <div class="week-nav">
        <a class="btn btn-ghost btn-icon btn-sm" href="@($"/wochenplan/{WeekOffset - 1}")" title="Vorherige Woche">←</a>
        <a class="btn btn-secondary btn-sm" href="/wochenplan">Diese Woche</a>
        <a class="btn btn-ghost btn-icon btn-sm" href="@($"/wochenplan/{WeekOffset + 1}")" title="Nächste Woche">→</a>
    </div>
    <div class="row" style="gap:0.75rem; flex-wrap:wrap; align-items:center;">
        <span class="text-sm muted">Planen:</span>
        <label class="row text-sm" style="gap:0.3rem; cursor:pointer;">
            <input type="checkbox" @bind="_fillFruehstueck" /> 🌅 Frühstück
        </label>
        <label class="row text-sm" style="gap:0.3rem; cursor:pointer;">
            <input type="checkbox" @bind="_fillMittag" /> ☀️ Mittagessen
        </label>
        <label class="row text-sm" style="gap:0.3rem; cursor:pointer;">
            <input type="checkbox" @bind="_fillAbend" /> 🌙 Abendessen
        </label>
    </div>
    <label class="row text-sm muted" style="gap:0.4rem;">
        <input type="checkbox" @bind="_overwriteOnGenerate" />
        Vorhandene überschreiben
    </label>
</div>

@if (_week is null)
{
    <span class="spinner"></span>
}
else
{
    var days = Enumerable.Range(0, 7).Select(i => _monday.AddDays(i)).ToList();
    var mealTypes = new[] { MealType.Fruehstueck, MealType.Mittagessen, MealType.Abendessen };

    <div class="week-grid">
        <div class="week-grid-corner"></div>
        @foreach (var day in days)
        {
            <div class="week-day-head @(day == DateOnly.FromDateTime(DateTime.Today) ? "is-today" : "")">
                <div class="dow">@day.ToString("ddd", _culture)</div>
                <div class="dom">@day.ToString("d. MMM", _culture)</div>
            </div>
        }

        @foreach (var mealType in mealTypes)
        {
            <div class="week-meal-label">
                <span>@mealType.ToIcon()</span>
                <span>@mealType.ToGermanLabel()</span>
            </div>

            @foreach (var day in days)
            {
                var entry = _week.Entries.FirstOrDefault(e => e.Date == day && e.MealType == mealType);
                <div class="week-slot @(entry?.MenuId is not null ? "filled" : "") @(entry?.IsAutoGenerated == true ? "auto" : "")"
                     @onclick="() => OpenPicker(entry)">
                    @if (entry?.Menu is not null)
                    {
                        <span class="slot-title">@entry.Menu.Name</span>
                        @if (entry.IsAutoGenerated)
                        {
                            <span class="slot-tag">✨ automatisch</span>
                        }
                    }
                    else
                    {
                        <span class="slot-empty">+</span>
                    }
                </div>
            }
        }
    </div>
}

@if (_pickerEntry is not null)
{
    <div class="modal-backdrop" @onclick="ClosePicker">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h3 class="mb-0">@_pickerEntry.MealType.ToGermanLabel()</h3>
                    <span class="text-sm muted">@_pickerEntry.Date.ToString("dddd, d. MMMM", _culture)</span>
                </div>
                <button class="btn btn-ghost btn-icon btn-sm" @onclick="ClosePicker">✕</button>
            </div>

            @if (_pickerEntry.MenuId is not null)
            {
                <button class="btn btn-danger btn-block" style="margin-bottom:1rem;" @onclick="() => AssignMenu(null)">Eintrag leeren</button>
            }

            @if (_pickerMenus.Count == 0)
            {
                <p class="muted">Noch keine Menüs für @_pickerEntry.MealType.ToGermanLabel() vorhanden.</p>
                <a class="btn btn-secondary btn-block" href="/menus/neu">Menü anlegen</a>
            }
            else
            {
                <div class="stack" style="gap:0.4rem; max-height:320px; overflow-y:auto;">
                    @foreach (var menu in _pickerMenus)
                    {
                        <div class="row-between chip-btn @(menu.Id == _pickerEntry.MenuId ? "active" : "")"
                             style="cursor:pointer; padding:0.6rem 0.85rem; border-radius:var(--radius-sm);"
                             @onclick="() => AssignMenu(menu.Id)">
                            <span>@menu.Name</span>
                            <span class="muted text-sm">@string.Join(", ", menu.MenuRecipes.Select(r => r.Recipe?.Name))</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int WeekOffset { get; set; }

    private readonly System.Globalization.CultureInfo _culture = new("de-DE");
    private DateOnly _monday;
    private Models.WeekPlan? _week;
    private WeekPlanEntry? _pickerEntry;
    private List<Menu> _pickerMenus = new();
    private bool _overwriteOnGenerate;
    private bool _generating;
    private bool _fillFruehstueck;
    private bool _fillMittag = true;
    private bool _fillAbend = true;
    private int _householdId;

    protected override async Task OnInitializedAsync()
    {
        _householdId = await CurrentUser.GetHouseholdIdAsync() ?? 0;
        ChangeNotifier.Subscribe(_householdId, OnExternalChange);
    }

    protected override async Task OnParametersSetAsync()
    {
        _monday = WeekPlanService.GetMonday(DateOnly.FromDateTime(DateTime.Today)).AddDays(WeekOffset * 7);
        _week = await WeekPlanService.GetOrCreateWeekAsync(_monday, _householdId);
    }

    private async Task OnExternalChange()
    {
        _week = await WeekPlanService.GetOrCreateWeekAsync(_monday, _householdId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChangeNotifier.Unsubscribe(_householdId, OnExternalChange);
    }

    private string FormatWeekRange()
    {
        var end = _monday.AddDays(6);
        var startFormat = _monday.Year == end.Year ? "d. MMMM" : "d. MMMM yyyy";
        return $"{_monday.ToString(startFormat, _culture)} – {end.ToString("d. MMMM yyyy", _culture)}";
    }

    private async Task OpenPicker(WeekPlanEntry? entry)
    {
        if (entry is null) return;
        _pickerEntry = entry;
        _pickerMenus = await MenuService.GetAllAsync(_householdId, entry.MealType);
    }

    private void ClosePicker() => _pickerEntry = null;

    private async Task AssignMenu(int? menuId)
    {
        if (_pickerEntry is null) return;
        await WeekPlanService.AssignMenuAsync(_pickerEntry.Id, menuId, _householdId);
        _pickerEntry = null;
        _week = await WeekPlanService.GetOrCreateWeekAsync(_monday, _householdId);
    }

    private async Task AutoGenerate()
    {
        if (_week is null) return;
        _generating = true;

        var slots = new HashSet<MealType>();
        if (_fillFruehstueck) slots.Add(MealType.Fruehstueck);
        if (_fillMittag) slots.Add(MealType.Mittagessen);
        if (_fillAbend) slots.Add(MealType.Abendessen);

        await WeekPlanService.AutoGenerateAsync(_week.Id, _overwriteOnGenerate, slots.Count > 0 ? slots : null, _householdId);
        _week = await WeekPlanService.GetOrCreateWeekAsync(_monday, _householdId);
        _generating = false;
    }

    private async Task ClearWeek()
    {
        if (_week is null) return;
        await WeekPlanService.ClearWeekAsync(_week.Id, _householdId);
        _week = await WeekPlanService.GetOrCreateWeekAsync(_monday, _householdId);
    }
}
