@inject IJSRuntime JS

<button type="button" class="theme-toggle" data-active="@_theme" title="Design wechseln" @onclick="Toggle">
    <span class="thumb"></span>
    <span class="icon @(_theme == "light" ? "active" : "")">☀️</span>
    <span class="icon @(_theme == "dark" ? "active" : "")">🌙</span>
</button>

@code {
    private string _theme = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("essensplanTheme.get");
            StateHasChanged();
        }
    }

    private async Task Toggle()
    {
        _theme = await JS.InvokeAsync<string>("essensplanTheme.toggle");
    }
}
