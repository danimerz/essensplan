@page "/passwort-zuruecksetzen"
@model Essensplan.Web.Pages.Account.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Neues Passwort – Essensplan</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <script>
        (function () {
            var stored = localStorage.getItem('essensplan-theme');
            var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="brand-mark" style="font-size:2.5rem;">🍲</div>
            <h1 style="margin:0.5rem 0 0.25rem;">Neues Passwort</h1>
            <p class="muted" style="margin:0;">@Model.Email</p>
        </div>

        @if (Model.Done)
        {
            <div class="alert alert-success">Dein Passwort wurde geändert.</div>
            <a class="btn btn-primary btn-block" href="/anmelden">Jetzt anmelden</a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">@Model.ErrorMessage</div>
            }
            <form method="post" asp-antiforgery="true">
                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="hidden" name="Code" value="@Model.Code" />
                <div class="form-group">
                    <label class="form-label" for="password">Neues Passwort (mind. 8 Zeichen)</label>
                    <input id="password" name="Password" type="password" class="form-control" autocomplete="new-password" required minlength="8" autofocus />
                </div>
                <div class="form-group">
                    <label class="form-label" for="confirm">Passwort wiederholen</label>
                    <input id="confirm" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required minlength="8" />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Passwort speichern</button>
            </form>
        }
        <p class="text-sm" style="text-align:center; margin-top:1.25rem;"><a href="/passwort-vergessen">Neuen Link anfordern</a> · <a href="/anmelden">Zur Anmeldung</a></p>
    </div>
</div>
</body>
</html>
