@page "/passwort-vergessen"
@model Essensplan.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Passwort vergessen – Essensplan</title>
    <link rel="stylesheet" href="~/app.css" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <script>
        (function () {
            var stored = localStorage.getItem('essensplan-theme');
            var theme = stored || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="brand-mark" style="font-size:2.5rem;">🍲</div>
            <h1 style="margin:0.5rem 0 0.25rem;">Passwort vergessen</h1>
            <p class="muted" style="margin:0;">Wir schicken dir einen Link per Mail.</p>
        </div>

        @if (!Model.MailAvailable)
        {
            <div class="alert alert-info">Der Mailversand ist noch nicht eingerichtet. Bitte wende dich an den Administrator.</div>
        }
        else if (Model.Sent)
        {
            <div class="alert alert-success">Falls es ein Konto mit dieser E-Mail gibt, ist die Mail unterwegs. Schau auch im Spam-Ordner nach.</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error">@Model.ErrorMessage</div>
            }
            <form method="post" asp-antiforgery="true">
                <div class="form-group">
                    <label class="form-label" for="email">E-Mail</label>
                    <input id="email" name="Email" type="email" class="form-control" value="@Model.Email" autocomplete="email" autofocus required />
                </div>
                <button type="submit" class="btn btn-primary btn-block">Link senden</button>
            </form>
        }
        <p class="text-sm" style="text-align:center; margin-top:1.25rem;"><a href="/anmelden">Zur Anmeldung</a></p>
    </div>
</div>
</body>
</html>
